                <hashTree/>
                <HtmlExtractor guiclass="HtmlExtractorGui" testclass="HtmlExtractor" testname="Extract_S3_Products_FromCategoryPage_Random" enabled="true">
                  <stringProp name="HtmlExtractor.refname">productLink</stringProp>
                  <stringProp name="HtmlExtractor.expr">#content .product-layout .image a</stringProp>
                  <stringProp name="HtmlExtractor.attribute">href</stringProp>
                  <stringProp name="HtmlExtractor.default">NO_PRODUCT_FOUND</stringProp>
                  <boolProp name="HtmlExtractor.default_empty_value">false</boolProp>
                  <stringProp name="HtmlExtractor.match_number">-1</stringProp>
                  <stringProp name="HtmlExtractor.extractor_impl"></stringProp>
                </HtmlExtractor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PickRandomProduct_FromList_S3" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">
int count = Integer.parseInt(vars.get(&apos;productLink_matchNr&apos;) ?: &apos;0&apos;);
if (count &gt; 0) {
    def rnd = 1 + new Random().nextInt(count);
    def url = vars.get(&apos;productLink_&apos; + rnd);
    if (url != null) url = url.trim();
    def base = &apos;http://172.23.176.138/opencart/upload&apos;;
    if (url &amp;&amp; !url.startsWith(&apos;http&apos;)) {
        if (url.startsWith(&apos;/&apos;)) {
            url = base + url;
        } else {
            url = base + &apos;/&apos; + url;
        }
    }
    vars.put(&apos;randomProductUrl&apos;, url ?: &apos;NO_PRODUCT_FOUND&apos;);
    log.info(&quot;S3: random product #&quot; + rnd + &quot; =&gt; &quot; + url);

    if (url) {
        String query = url.contains(&apos;?&apos;) ? url.substring(url.indexOf(&apos;?&apos;) + 1) : &apos;&apos;;
        String productId = &apos;NO_ID&apos;;
        query.split(&apos;&amp;&apos;).each { part -&gt;
            def kv = part.split(&apos;=&apos;);
            if (kv.length == 2 &amp;&amp; kv[0] == &apos;product_id&apos;) {
                productId = kv[1];
            }
        }
        vars.put(&apos;productId&apos;, productId);
        log.info(&apos;S3: Extracted productId = &apos; + productId);
    } else {
        vars.put(&apos;productId&apos;, &apos;NO_ID&apos;);
        log.warn(&apos;S3: No URL for product, setting productId=NO_ID&apos;);
    }
} else {
    vars.put(&apos;randomProductUrl&apos;, &apos;NO_PRODUCT_FOUND&apos;);
    vars.put(&apos;productId&apos;, &apos;NO_ID&apos;);
    log.warn(&quot;S3: No product links found on CategoryPage!&quot;);
}
          </stringProp>
                </JSR223PostProcessor>
