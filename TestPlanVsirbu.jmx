                  <stringProp name="HtmlExtractor.extractor_impl"></stringProp>
                </HtmlExtractor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PickRandomCategory_FromMenu_S3" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script">
int count = Integer.parseInt(vars.get(&apos;categoryLink_matchNr&apos;) ?: &apos;0&apos;);
if (count &gt; 0) {
    def rnd = 1 + new Random().nextInt(count);
    def url = vars.get(&apos;categoryLink_&apos; + rnd);
    if (url != null) url = url.trim();
    def base = &apos;http://172.23.176.138/opencart/upload&apos;;
    if (url &amp;&amp; !url.startsWith(&apos;http&apos;)) {
        if (url.startsWith(&apos;/&apos;)) {
            url = base + url;
        } else {
            url = base + &apos;/&apos; + url;
        }
    }
    vars.put(&apos;randomCategoryUrl&apos;, url ?: &apos;NO_CATEGORY_FOUND&apos;);
    log.info(&quot;S3: random category #&quot; + rnd + &quot; =&gt; &quot; + url);
} else {
    vars.put(&apos;randomCategoryUrl&apos;, &apos;NO_CATEGORY_FOUND&apos;);
    log.warn(&quot;S3: No category links found on HomePage!&quot;);
}
          </stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
