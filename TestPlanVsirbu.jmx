                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PickRandomProduct_FromList_L">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">
int count = Integer.parseInt(vars.get(&apos;L_productLink_matchNr&apos;) ?: &apos;0&apos;);
if (count &gt; 0) {
    def rnd = 1 + new Random().nextInt(count);
    def url = vars.get(&apos;L_productLink_&apos; + rnd);
    if (url != null) url = url.trim();
    def base = &apos;http://172.23.176.138/opencart/upload&apos;;
    if (url &amp;&amp; !url.startsWith(&apos;http&apos;)) {
        if (url.startsWith(&apos;/&apos;)) {
            url = base + url;
        } else {
            url = base + &apos;/&apos; + url;
        }
    }
    vars.put(&apos;L_randomProductUrl&apos;, url ?: &apos;NO_PRODUCT_FOUND&apos;);
    log.info(&apos;Login TG: random product #&apos; + rnd + &apos; =&gt; &apos; + url);
} else {
    vars.put(&apos;L_randomProductUrl&apos;, &apos;NO_PRODUCT_FOUND&apos;);
    log.warn(&apos;Login TG: No product links found on CategoryPage!&apos;);
}
        </stringProp>
                </JSR223PostProcessor>
