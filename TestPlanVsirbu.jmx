                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PickRandomCategory_FromMenu_L">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="script">
int count = Integer.parseInt(vars.get(&apos;L_categoryLink_matchNr&apos;) ?: &apos;0&apos;);
if (count &gt; 0) {
    def rnd = 1 + new Random().nextInt(count);
    def url = vars.get(&apos;L_categoryLink_&apos; + rnd);
    if (url != null) url = url.trim();
    def base = &apos;http://172.23.176.138/opencart/upload&apos;;
    if (url &amp;&amp; !url.startsWith(&apos;http&apos;)) {
        if (url.startsWith(&apos;/&apos;)) {
            url = base + url;
        } else {
            url = base + &apos;/&apos; + url;
        }
    }
    vars.put(&apos;L_randomCategoryUrl&apos;, url ?: &apos;NO_CATEGORY_FOUND&apos;);
    log.info(&apos;Login TG: random category #&apos; + rnd + &apos; =&gt; &apos; + url);
} else {
    vars.put(&apos;L_randomCategoryUrl&apos;, &apos;NO_CATEGORY_FOUND&apos;);
    log.warn(&apos;Login TG: No category links found on HomePage!&apos;);
}
        </stringProp>
                </JSR223PostProcessor>
