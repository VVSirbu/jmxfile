                  <stringProp name="HtmlExtractor.attribute">href</stringProp>
                  <stringProp name="HtmlExtractor.default">NO_CATEGORY_FOUND</stringProp>
                  <boolProp name="HtmlExtractor.default_empty_value">false</boolProp>
