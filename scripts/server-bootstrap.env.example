# Copy this file to server-bootstrap.env on the server and fill in real values.
# Do not commit server-bootstrap.env because it contains secrets.

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-strong-password
JENKINS_PORT=8081
JENKINS_PUBLIC_URL=http://YOUR_SERVER_IP:8081/

# Jenkins will use this repository URL to load Jenkinsfiles.
APP_GIT_REPO_URL=https://github.com/your-org/jmxtok6changer.git
APP_GIT_BRANCH=main
APP_GIT_CREDENTIALS_ID=

JENKINS_CONTAINER_NAME=jmxtok6-jenkins
JENKINS_NETWORK_NAME=jmxtok6
JENKINS_IMAGE_NAME=jmxtok6-jenkins
JENKINS_IMAGE_TAG=local
