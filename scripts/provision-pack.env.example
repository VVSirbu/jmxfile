# Copy this file to provision-pack.env on the server and fill in real values.
# Do not commit provision-pack.env because it contains secrets.

# Public server address used by Jenkins jobs and generated URLs.
SERVER_HOST=YOUR_SERVER_IP

# Linux user that will own the project directory and run server-side Docker tasks.
SERVICE_USER=jmxtok6
SERVICE_USER_PASSWORD=change-me-service-user-password
SERVICE_USER_SHELL=/bin/bash
SERVICE_USER_SUDO=true

# Fixed directories on the server.
BASE_DIR=/opt
PROJECT_DIR=/opt/jmxfile
ARTIFACTS_DIR=/opt/jmxtok6changer/artifacts

# Git repository used by Jenkins and by this pack.
APP_GIT_REPO_URL=https://github.com/VVSirbu/jmxfile.git
APP_GIT_BRANCH=main
APP_GIT_CREDENTIALS_ID=

# Jenkins.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-strong-password
JENKINS_PORT=8081
JENKINS_CONTAINER_NAME=jmxtok6-jenkins
JENKINS_NETWORK_NAME=jmxtok6
JENKINS_IMAGE_NAME=jmxtok6-jenkins
JENKINS_IMAGE_TAG=local

# Jenkins credential that will be created automatically for Ansible password SSH.
TARGET_SSH_PASSWORD_CREDENTIALS_ID=jmxtok6-server-password

# Application deployment defaults used by Jenkins setup-environment.
IMAGE_NAME=jmxtok6changer
IMAGE_TAG=latest
CONTAINER_NAME=jmxtok6changer
HOST_PORT=8080
DOCKER_NETWORK=jmxtok6
