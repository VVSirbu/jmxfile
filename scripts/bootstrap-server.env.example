# Copy this file to bootstrap-server.env and fill in real values.
# Do not commit bootstrap-server.env because it contains secrets.

SERVER_HOST=YOUR_SERVER_IP
SSH_USER=ubuntu
SSH_KEY_PATH=C:\Users\you\.ssh\id_rsa

REPO_URL=https://github.com/your-org/jmxtok6changer.git
BRANCH=main
REMOTE_PROJECT_DIR=/opt/jmxtok6changer

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-strong-password
JENKINS_PORT=8081
JENKINS_PUBLIC_URL=http://YOUR_SERVER_IP:8081/

SERVICE_PORT=8080
APP_GIT_CREDENTIALS_ID=

# true means: only provision Jenkins, do not trigger the deploy job automatically.
SKIP_JENKINS_DEPLOY=true
