# Copy to 00-zero-server.env on a brand-new server.
# This file is intentionally the single source of truth for the bootstrap layer.
# Do not commit the filled file because it contains passwords.

# Public server address.
SERVER_HOST=YOUR_SERVER_IP

# Repository to clone after base dependencies are installed.
REPO_URL=https://github.com/VVSirbu/jmxfile.git
REPO_BRANCH=main
PROJECT_DIR=/opt/jmxfile

# Linux users and directories.
ADMIN_USER=jmxtok6
ADMIN_PASSWORD=change-me-linux-password
ARTIFACTS_DIR=/opt/jmxtok6changer/artifacts

# Jenkins managed by Terraform.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins-password
JENKINS_PORT=8081
JENKINS_CONTAINER_NAME=jmxtok6-jenkins
JENKINS_NETWORK_NAME=jmxtok6
JENKINS_IMAGE_NAME=jmxtok6-jenkins
JENKINS_IMAGE_TAG=local

# Jenkins credential created by JCasC and used later by Ansible jobs.
TARGET_SSH_PASSWORD_CREDENTIALS_ID=jmxtok6-server-password

# App defaults passed later to Jenkins setup-environment.
APP_CONTAINER_NAME=jmxtok6changer
APP_IMAGE_NAME=jmxtok6changer
APP_IMAGE_TAG=latest
APP_HOST_PORT=8080
APP_DOCKER_NETWORK=jmxtok6
